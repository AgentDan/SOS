{
  "name": "sos",
  "version": "0.1.0",
  "description": "SOS - AI workspace configurator skeleton",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch backend --ext js,mjs,cjs backend/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "admin": "vite --config admin/vite.config.js",
    "test": "node --test \"backend/**/*.test.js\" \"admin/**/*.test.js\"",
    "validate": "node scripts/validate.js",
    "publish-config": "node scripts/publish.js",
    "scenario": "node scripts/scenario-runner.js",
    "build:client": "vite build --config client/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "check": "npm test && node scripts/validate.js && node scripts/scenario-runner.js && vite build --config client/vite.config.js && vite build --config admin/vite.config.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "nodemon": "^3.1.4",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.6"
  }
}
